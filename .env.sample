### replace the content inside the curly brackets

### 1. {project_name}: your project name e.g my_project !!!no spaces and special characters 
COMPOSE_PROJECT_NAME={project_name}

DOCKER_ENV=production

##########################################################################################
###### Web GIs Catalogue - GEONODE (it uses geoserver, redis, postgreSQL/Postgis, nginx) 
######
###### You can find more information at 
######    https://docs.geonode.org/en/latest/setup/configuration/settings/
######

### 2. {pgpwd} : Main postgres password (user postgres)
### 3. {dbpwd} :  db password of the {project_name} db user
### 3. {geodbpwd} : db password of the {project_name}_data user  
### 4. {siteurl} : public domanin url. In development can be "http://localhost", in production should have certificates "https://mydomain.com"  
### 5. {hostname} : host name accordly with siteurl. In development can be "localhost", in production "mydomain.com"  
### 6. {http_host}: if you don't use https put the hostname else nothing ( if http_host is set then https_host isn't set and viceversa )
### 7. {https_host}: if you use https put the hostname else nothing  ( if http_host is set then https_host isn't set and viceversa )
### 8. {letsencrypt_mode}: see the comment
### 9. {geoserverpwd}: geoserver admin password
### 10. WARNING: in GEOSERVER_JAVA_OPTS replace {site_url inside curly brackets {siteurl}   
### 11. {geonodepwd}: Web GIs Catalogue ADMIN user password  
### 12. {email}: Web GIs Catalogue ADMIN user email 
### 13. {authapikey}: key of the auth api in oauth2  (geonode-geoserver connection) e.g 'fR3cr3t32632354gsdsds5544g332632gbow43ASDD2FFIUIGJGR546B&yy0rut'
### 14. {clientid}: client id in oauth2  (geonode-geoserver connection) e.g 'rwerpljfdsw26utmff32n32632gauffwboaga3003'
### 15. {clientsecret}: client secret phrase in oauth2  (geonode-geoserver connection) e.g 'hjkjt3cr3t32632geo4326sg4g4326gbow43ASDD2FFIUIGJGR546BNC'
### 16. {secret_key}: secret kay e.g 'ttt234juO(cCe,pGovWPNX5RttE345]6o&*^+00WyRbZf{Hn=+PjJ3%<+qq'
  
##########################################################################################

GEONODE_BASE_IMAGE_VERSION=5.1.0
NGINX_BASE_IMAGE_VERSION=1.31.3-alpine
LETSENCRYPT_BASE_IMAGE_VERSION=2.6.0-latest
GEOSERVER_BASE_IMAGE_VERSION=2.28.4-latest
POSTGRES_BASE_IMAGE_VERSION=15-3.5-latest

C_FORCE_ROOT=1
FORCE_REINIT=false
INVOKE_LOG_STDOUT=true
DJANGO_SETTINGS_MODULE={project_name}.settings
GEONODE_INSTANCE_NAME=geonode


POSTGRES_USER=postgres
POSTGRES_PASSWORD={pgpwd}
GEONODE_DATABASE={project_name}
GEONODE_DATABASE_USER={project_name}
GEONODE_DATABASE_PASSWORD={dbpwd}
GEONODE_GEODATABASE={project_name}_data
GEONODE_GEODATABASE_USER={project_name}_data
GEONODE_GEODATABASE_PASSWORD={geodbpwd}
GEONODE_DATABASE_SCHEMA=public
GEONODE_GEODATABASE_SCHEMA=public
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_URL=postgis://{project_name}:{dbpwd}@db:5432/{project_name}
GEODATABASE_URL=postgis://{project_name}_data:{geodbpwd}@db:5432/{project_name}_data
GEONODE_DB_CONN_MAX_AGE=0
GEONODE_DB_CONN_TOUT=5
DEFAULT_BACKEND_DATASTORE=datastore
POSTGRESQL_MAX_CONNECTIONS=200

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD={redis_pwd}
BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/1
CELERY_BEAT_SCHEDULER=celery.beat:PersistentScheduler
ASYNC_SIGNALS=True

SITEURL={siteurl}/
NGINX_BASE_URL=${SITEURL}
ALLOWED_HOSTS=['django', '{hostname}', 'geonode', 'geoserver', 'localhost', '127.0.0.1']

GEONODE_LB_HOST_IP=django
GEONODE_LB_PORT=8000

# IP or domain name and port where the server can be reached on HTTPS (leave HOST empty if you want to use HTTP only)
# port where the server can be reached on HTTPS
HTTP_HOST={http_host}
HTTPS_HOST={https_host}

HTTP_PORT=80
HTTPS_PORT=443

# Let's Encrypt certificates for https encryption. You must have a domain name as HTTPS_HOST (doesn't work
# with an ip) and it must be reachable from the outside. This can be one of the following :
# disabled : we do not get a certificate at all (a placeholder certificate will be used)
# staging : we get staging certificates (are invalid, but allow to test the process completely and have much higher limit rates)
# production : we get a normal certificate (default)
LETSENCRYPT_MODE={letsencrypt_mode}

RESOLVER=127.0.0.11

GEOSERVER_LB_HOST_IP=geoserver
GEOSERVER_LB_PORT=8080
GEOSERVER_WEB_UI_LOCATION={siteurl}/geoserver/
GEOSERVER_PUBLIC_LOCATION={siteurl}/geoserver/
GEOSERVER_LOCATION=http://${GEOSERVER_LB_HOST_IP}:${GEOSERVER_LB_PORT}/geoserver/
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD={geoserverpwd}

OGC_REQUEST_TIMEOUT=30
OGC_REQUEST_MAX_RETRIES=1
OGC_REQUEST_BACKOFF_FACTOR=0.3
OGC_REQUEST_POOL_MAXSIZE=10
OGC_REQUEST_POOL_CONNECTIONS=10

# Java Options & Memory
ENABLE_JSONP=true
outFormat=text/javascript
GEOSERVER_JAVA_OPTS="-Djava.awt.headless=true -Xms4G -Xmx4G -Dgwc.context.suffix=gwc -XX:+UnlockDiagnosticVMOptions -XX:+LogVMOutput -XX:LogFile=/var/log/jvm.log -XX:PerfDataSamplingInterval=500 -XX:SoftRefLRUPolicyMSPerMB=36000 -XX:-UseGCOverheadLimit -XX:ParallelGCThreads=4 -Dfile.encoding=UTF8 -Djavax.servlet.request.encoding=UTF-8 -Djavax.servlet.response.encoding=UTF-8 -Duser.timezone=GMT -Dorg.geotools.shapefile.datetime=false -DGS-SHAPEFILE-CHARSET=UTF-8 -DGEOSERVER_CSRF_DISABLED=true -DPRINT_BASE_URL={siteurl}/geoserver/pdf -DALLOW_ENV_PARAMETRIZATION=true -Xbootclasspath/a:/usr/local/tomcat/webapps/geoserver/WEB-INF/lib/marlin-0.9.3-Unsafe.jar -Dsun.java2d.renderer=org.marlin.pisces.MarlinRenderingEngine"

STATIC_ROOT=/mnt/volumes/statics/static/
MEDIA_ROOT=/mnt/volumes/statics/uploaded/
ASSETS_ROOT=/mnt/volumes/statics/assets/
GEOIP_PATH=/mnt/volumes/statics/geoip.db


# Admin Settings
#
# ADMIN_PASSWORD is used to overwrite the GeoNode admin password **ONLY** the first time
# GeoNode is run. If you need to overwrite it again, you need to set the env var FORCE_REINIT,
# otherwise the invoke updateadmin task will be skipped and the current password already stored
# in DB will honored.
ADMIN_USERNAME=admin
ADMIN_PASSWORD={geonodepwd}
ADMIN_EMAIL={email}

# Session/Access Control
LOCKDOWN_GEONODE=False
X_FRAME_OPTIONS="SAMEORIGIN"
SESSION_EXPIRED_CONTROL_ENABLED=True
DEFAULT_ANONYMOUS_PERMISSIONS=download
DEFAULT_REGISTERED_MEMBERS_PERMISSIONS=download

CORS_ALLOW_ALL_ORIGINS=False # era true
GEOSERVER_CORS_ENABLED=True 
GEOSERVER_CORS_ALLOWED_ORIGINS=https://soilgislab.crs4.it 
GEOSERVER_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,HEAD,OPTIONS
GEOSERVER_CORS_ALLOWED_HEADERS=*

# Users Registration (!!!only catalogue)
ACCOUNT_LOGIN_METHODS = {'email', 'username'}
ACCOUNT_OPEN_SIGNUP=False
ACCOUNT_SIGNUP_FIELDS = ['email*', 'username*', 'password1*', 'password2*']
ACCOUNT_APPROVAL_REQUIRED=True
ACCOUNT_CONFIRM_EMAIL_ON_GET=False
ACCOUNT_EMAIL_VERIFICATION=none
ACCOUNT_EMAIL_CONFIRMATION_EMAIL=False
ACCOUNT_EMAIL_CONFIRMATION_REQUIRED=False
AUTO_ASSIGN_REGISTERED_MEMBERS_TO_REGISTERED_MEMBERS_GROUP_NAME=False
AUTO_ASSIGN_REGISTERED_MEMBERS_TO_CONTRIBUTORS=False
REGISTERED_MEMBERS_GROUP_NAME=registered-members

# OAuth2
OAUTH2_API_KEY={authapikey}
OAUTH2_CLIENT_ID={clientid}
OAUTH2_CLIENT_SECRET={clientsecret}

# GeoNode APIs
API_LOCKDOWN=False
TASTYPIE_APIKEY=

DEBUG=False

SECRET_KEY='{secret_key}'

CACHE_BUSTING_STATIC_ENABLED=False

MEMCACHED_ENABLED=False
MEMCACHED_LOCATION=memcached:11211
MEMCACHED_OPTIONS=

MAX_DOCUMENT_SIZE=200
CLIENT_RESULTS_LIMIT=5
API_LIMIT_PER_PAGE=1000

# GIS Client
BING_API_KEY=

# Monitoring
MONITORING_ENABLED=False
MONITORING_DATA_TTL=365
USER_ANALYTICS_ENABLED=True
USER_ANALYTICS_GZIP=True
CENTRALIZED_DASHBOARD_ENABLED=False
MONITORING_SERVICE_NAME=local-geonode
MONITORING_HOST_NAME=geonode

# Other Options/Contribs
MODIFY_TOPICCATEGORY=True
AVATAR_GRAVATAR_SSL=True
EXIF_ENABLED=True
CREATE_LAYER=True
FAVORITE_ENABLED=True

# Common containers restart policy
RESTART_POLICY_CONDITION="on-failure"
RESTART_POLICY_DELAY="5s"
RESTART_POLICY_MAX_ATTEMPTS="3"
RESTART_POLICY_WINDOW=120s

CELERY__LOG_LEVEL="ERROR"
CELERY__LOG_FILE="/var/log/celery.log"

DEFAULT_MAX_UPLOAD_SIZE=5368709120
DEFAULT_MAX_PARALLEL_UPLOADS_PER_USER=5

##########################################################################################
###### Backend API- Laravel (it uses mysql, redis, nginx) 
######

### 17. {jwt_secret} : JWT secret used by Laravel APP
### 18. {mysql_database_name} : MYSQL database name
### 19. {mysql_user_name} : MYSQL user name 
### 20. {mysql_password} : MYSQL user password
### 21. {wocat_token} : to be requested from Wocat 
  
##########################################################################################

APP_NAME=plan4ldn-be
APP_SERVICE=plan4ldn-be
APP_ENV=local
APP_KEY=base64:w2DDoJChoi9II9uysjj+kobw2dKZHWgqNq2Ki7k3nw4=
APP_DEBUG=false
APP_URL={siteurl}
APP_PORT=3033
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

JWT_SECRET={jwt_secret}
JWT_TTL=480

REQUESTS_PER_MINUTE_LIMIT=600
REQUEST_TIMEOUT_SECONDS=15
CACHE_TTL_SECONDS=3600

# MySQL
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE={mysql_database_name}
DB_USERNAME={mysql_user_name}
DB_PASSWORD={mysql_password}
DB_ALLOW_EMPTY_PASSWORD='no'
      
SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis for laravel
REDIS_CLIENT=predis

# Wocat token : to be requested from Wocat 
WOCAT_TOKEN={wocat_token}

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME=${APP_NAME}

VITE_APP_NAME=${APP_NAME}

##########################################################################################
###### Frontend dashboard (it uses  nginx) 
######
##########################################################################################

# The application environment.
REACT_APP_ENVIRONMENT="production"
# The timeout when making HTTP requests in seconds.
NEXT_PUBLIC_REQUEST_TIMEOUT=60
# The API base URL.
NEXT_PUBLIC_API_BASE_URL=${SITEURL}plan4ldn-api/api
# How frequently we poll for new invitations (in seconds)
NEXT_PUBLIC_INVITATION_POLLING_FREQUENCY=120
NEXT_PUBLIC_LOCAL_STORAGE_KEY='_____change_it________'
NEXT_PUBLIC_URL=${SITEURL}plan4ldn 
NEXT_PUBLIC_GEOSERVER_URL=${SITEURL}geoserver/
NEXT_PUBLIC_APP_NAME=${COMPOSE_PROJECT_NAME}